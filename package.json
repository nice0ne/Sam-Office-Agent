{
  "name": "sam-office-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:tray": "powershell -ExecutionPolicy Bypass -File ./scripts/build-tray-installer.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sideload": "powershell -ExecutionPolicy Bypass -File ./scripts/register-addin.ps1",
    "sideload:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/unregister-addin.ps1",
    "certs:install": "office-addin-dev-certs install"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.450",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "office-addin-dev-certs": "^2.0.10",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
